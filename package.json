{
	"name": "obsidian-edit-history-heatmap",
	"version": "0.1.7",
	"description": "Visualize writing activity from Obsidian Sync history.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node test/run-tests.mjs"
	},
	"keywords": [
		"obsidian",
		"heatmap",
		"writing",
		"history",
		"sync"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/keptan/obsidian-activity-heatmap.git"
	},
	"bugs": {
		"url": "https://github.com/keptan/obsidian-activity-heatmap/issues"
	},
	"homepage": "https://github.com/keptan/obsidian-activity-heatmap#readme",
	"license": "MIT",
	"dependencies": {
		"diff": "^8.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
